# Copy to .env and paste a key. Only the generation step (the final LLM answer) needs one.

# Default: OpenAI (what the slides used)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6-luna

# Or a provider with a free tier: set LLM_PROVIDER and that provider's key
# LLM_PROVIDER=groq
# GROQ_API_KEY=
# LLM_PROVIDER=google
# GEMINI_API_KEY=
# LLM_MODEL=           # optional: overrides the provider's default model
